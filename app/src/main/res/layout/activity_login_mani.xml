<?xml version="1.0" encoding="utf-8"?>

<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fondo_app">

    <!-- ================================================= -->
    <!-- FONDO DE VERDURAS -->
    <!-- ================================================= -->

    <ImageView
        android:id="@+id/imgFondoLogin"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@drawable/fondo_sirae"
        android:scaleType="centerCrop"
        android:contentDescription="@null" />

    <!-- ================================================= -->
    <!-- CAPA BLANCA TRANSPARENTE -->
    <!-- Ayuda a que el formulario se vea mejor -->
    <!-- ================================================= -->

    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- ================================================= -->
    <!-- CONTENIDO DEL LOGIN -->
    <!-- ================================================= -->

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:paddingTop="25dp"
            android:paddingBottom="25dp">

            <!-- ================================================= -->
            <!-- TARJETA LOGIN -->
            <!-- ================================================= -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="18dp"
                android:paddingTop="20dp"
                android:paddingEnd="18dp"
                android:paddingBottom="22dp"
                android:background="@drawable/bg_card_dashboard">

                <!-- ================================================= -->
                <!-- LOGO PAE COMO IMAGEN -->
                <!-- ================================================= -->

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="vertical">

                    <ImageView
                        android:id="@+id/imgLogoPAE"
                        android:layout_width="190dp"
                        android:layout_height="100dp"
                        android:adjustViewBounds="true"
                        android:contentDescription="Logo PAE"
                        android:scaleType="fitCenter"
                        android:src="@drawable/logo_pae" />

                </LinearLayout>


                <!-- ================================================= -->
                <!-- TITULO -->
                <!-- ================================================= -->

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="15dp"
                    android:gravity="center"
                    android:text="Iniciar sesión"
                    android:textColor="@color/texto_principal"
                    android:textSize="18sp"
                    android:textStyle="bold" />


                <!-- ================================================= -->
                <!-- CORREO ELECTRÓNICO -->
                <!-- ================================================= -->

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:text="Correo electrónico"
                    android:textColor="@color/texto_principal"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/edtCorreo"
                    android:layout_width="match_parent"
                    android:layout_height="45dp"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/bg_bottom_navigation"
                    android:hint="ejemplo@correo.com"
                    android:inputType="textEmailAddress"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:singleLine="true"
                    android:textColor="@color/texto_principal"
                    android:textColorHint="@color/texto_gris"
                    android:textSize="12sp" />


                <!-- ================================================= -->
                <!-- CONTRASEÑA -->
                <!-- ================================================= -->

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="Contraseña"
                    android:textColor="@color/texto_principal"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/edtContrasena"
                    android:layout_width="match_parent"
                    android:layout_height="45dp"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/bg_bottom_navigation"
                    android:hint="Ingresa tu contraseña"
                    android:inputType="textPassword"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:singleLine="true"
                    android:textColor="@color/texto_principal"
                    android:textColorHint="@color/texto_gris"
                    android:textSize="12sp" />


                <!-- ================================================= -->
                <!-- OLVIDASTE TU CONTRASEÑA -->
                <!-- ================================================= -->

                <TextView
                    android:id="@+id/btnOlvideContrasena"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="13dp"
                    android:text="¿Olvidaste tu contraseña?"
                    android:textColor="@color/verde_exito"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:clickable="true"
                    android:focusable="true" />


                <!-- ================================================= -->
                <!-- BOTÓN INGRESAR -->
                <!-- ================================================= -->

                <TextView
                    android:id="@+id/btnIngresar"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="20dp"
                    android:background="@drawable/bg_boton_estado_pendiente"
                    android:gravity="center"
                    android:text="Ingresar"
                    android:textColor="@color/texto_principal"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:clickable="true"
                    android:focusable="true" />


                <!-- ================================================= -->
                <!-- CREAR CUENTA -->
                <!-- ================================================= -->

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:gravity="center"
                    android:text="¿No tienes cuenta?"
                    android:textColor="@color/texto_gris"
                    android:textSize="11sp" />


                <TextView
                    android:id="@+id/btnContactarAdministrador"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:gravity="center"
                    android:text="Contacta al administrador"
                    android:textColor="@color/texto_principal"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:clickable="true"
                    android:focusable="true" />

            </LinearLayout>

        </LinearLayout>

    </ScrollView>

</FrameLayout>
