<?xml version="1.0" encoding="utf-8"?>

<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#F7F8FA">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp">

        <!-- TITULO -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Mi perfil"
            android:textColor="#202124"
            android:textSize="23sp"
            android:textStyle="bold"
            android:padding="5dp"
            android:layout_marginBottom="15dp" />


        <!-- PERFIL -->

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="17dp"
            app:cardElevation="2dp"
            app:cardBackgroundColor="#FFFFFF">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="15dp"
                android:background="@drawable/perfil_borde_amarillo">

                <ImageView
                    android:id="@+id/imgPerfil"
                    android:layout_width="72dp"
                    android:layout_height="72dp"
                    android:layout_marginEnd="15dp"
                    android:src="@drawable/img"
                    android:scaleType="centerCrop"
                    android:contentDescription="Foto de perfil" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/txtNombre"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Laura Gómez"
                        android:textColor="#202124"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/txtCargo"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="Manipuladora de alimentos"
                        android:textColor="#666666"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/txtInstitucion"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="I.E. La Paz"
                        android:textColor="#666666"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/txtTelefono"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:text="300 123 4567"
                        android:textColor="#555555"
                        android:textSize="14sp" />

                </LinearLayout>

            </LinearLayout>

        </androidx.cardview.widget.CardView>


        <!-- GUIAS -->

        <androidx.cardview.widget.CardView
            android:id="@+id/cardGuias"
            android:layout_width="match_parent"
            android:layout_height="76dp"
            android:layout_marginBottom="12dp"
            android:clickable="true"
            android:focusable="true"
            app:cardCornerRadius="17dp"
            app:cardElevation="2dp"
            app:cardBackgroundColor="#FFFFFF">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="14dp"
                android:paddingEnd="10dp"
                android:background="@drawable/perfil_borde_amarillo">

                <!-- ICONO -->

                <ImageView
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:padding="9dp"
                    android:src="@drawable/perfil_ic_book"
                    android:contentDescription="Guías de preparación" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="10dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Guías de preparación"
                        android:textColor="#222222"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="Pasos y buenas prácticas"
                        android:textColor="#777777"
                        android:textSize="12sp" />

                </LinearLayout>

                <TextView
                    android:layout_width="30dp"
                    android:layout_height="wrap_content"
                    android:text="›"
                    android:textSize="28sp"
                    android:textColor="#D9A900"
                    android:gravity="center" />

            </LinearLayout>

        </androidx.cardview.widget.CardView>


        <!-- MANUAL -->

        <androidx.cardview.widget.CardView
            android:id="@+id/cardManual"
            android:layout_width="match_parent"
            android:layout_height="76dp"
            android:layout_marginBottom="12dp"
            android:clickable="true"
            android:focusable="true"
            app:cardCornerRadius="17dp"
            app:cardElevation="2dp"
            app:cardBackgroundColor="#FFFFFF">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="14dp"
                android:paddingEnd="10dp"
                android:background="@drawable/perfil_borde_amarillo">

                <!-- ICONO -->

                <ImageView
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:padding="9dp"
                    android:src="@drawable/perfil_ic_cleaning"
                    android:contentDescription="Manual de higiene" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="10dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Manual de higiene"
                        android:textColor="#222222"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="Recomendaciones de limpieza"
                        android:textColor="#777777"
                        android:textSize="12sp" />

                </LinearLayout>

                <TextView
                    android:layout_width="30dp"
                    android:layout_height="wrap_content"
                    android:text="›"
                    android:textSize="28sp"
                    android:textColor="#D9A900"
                    android:gravity="center" />

            </LinearLayout>

        </androidx.cardview.widget.CardView>


        <!-- ACERCA DE LA APP -->

        <androidx.cardview.widget.CardView
            android:id="@+id/cardAcerca"
            android:layout_width="match_parent"
            android:layout_height="76dp"
            android:layout_marginBottom="12dp"
            android:clickable="true"
            android:focusable="true"
            app:cardCornerRadius="17dp"
            app:cardElevation="2dp"
            app:cardBackgroundColor="#FFFFFF">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="14dp"
                android:paddingEnd="10dp"
                android:background="@drawable/perfil_borde_amarillo">

                <!-- ICONO -->

                <ImageView
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:padding="9dp"
                    android:src="@drawable/perfil_ic_info"
                    android:contentDescription="Acerca de la aplicación" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="10dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Acerca de la app"
                        android:textColor="#222222"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="Versión 1.0.0"
                        android:textColor="#777777"
                        android:textSize="12sp" />

                </LinearLayout>

                <TextView
                    android:layout_width="30dp"
                    android:layout_height="wrap_content"
                    android:text="›"
                    android:textSize="28sp"
                    android:textColor="#D9A900"
                    android:gravity="center" />

            </LinearLayout>

        </androidx.cardview.widget.CardView>


        <!-- CERRAR SESIÓN -->

        <androidx.cardview.widget.CardView
            android:id="@+id/cardCerrarSesion"
            android:layout_width="match_parent"
            android:layout_height="76dp"
            android:clickable="true"
            android:focusable="true"
            app:cardCornerRadius="17dp"
            app:cardElevation="2dp"
            app:cardBackgroundColor="#FFFFFF">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="14dp"
                android:paddingEnd="10dp"
                android:background="@drawable/perfil_borde_amarillo">

                <!-- ICONO -->

                <ImageView
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:padding="9dp"
                    android:src="@drawable/perfil_ic_logout"
                    android:contentDescription="Cerrar sesión" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="10dp"
                    android:text="Cerrar sesión"
                    android:textColor="#222222"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="30dp"
                    android:layout_height="wrap_content"
                    android:text="›"
                    android:textSize="28sp"
                    android:textColor="#D9A900"
                    android:gravity="center" />

            </LinearLayout>

        </androidx.cardview.widget.CardView>

    </LinearLayout>

</ScrollView>