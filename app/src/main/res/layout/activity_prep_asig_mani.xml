<?xml version="1.0" encoding="utf-8"?>

<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fondo_app">

    <!-- ================================= -->
    <!-- FONDO VERDE SUPERIOR -->
    <!-- ================================= -->

    <ImageView
        android:id="@+id/curvaVerde"
        android:layout_width="match_parent"
        android:layout_height="200dp"
        android:src="@drawable/inicio"
        android:scaleType="fitXY"
        android:contentDescription="@null" />


    <!-- ================================= -->
    <!-- CONTENIDO -->
    <!-- ================================= -->

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginBottom="80dp"
        android:background="@android:color/transparent"
        android:fillViewport="true"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="40dp"
            android:paddingBottom="20dp">


            <!-- ================================= -->
            <!-- ENCABEZADO -->
            <!-- ================================= -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">


                <!-- BOTÓN VOLVER -->

                <ImageView
                    android:id="@+id/btnVolver"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:padding="7dp"
                    android:src="@drawable/ic_arrow_back"
                    android:contentDescription="Volver"
                    android:clickable="true"
                    android:focusable="true" />


                <!-- TÍTULO -->

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="0dp"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/txtTitulo"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Preparaciones asignadas"
                        android:textColor="@color/texto_principal"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/txtCategoria"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Desayuno"
                        android:textColor="@color/negro"
                        android:textSize="14sp" />

                </LinearLayout>

            </LinearLayout>


            <!-- ================================= -->
            <!-- FECHA -->
            <!-- ================================= -->

            <LinearLayout
                android:id="@+id/btnFecha"
                android:layout_width="240dp"
                android:layout_height="52dp"
                android:layout_marginTop="18dp"
                android:background="@drawable/bg_fecha"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="13dp"
                android:paddingEnd="13dp"
                android:clickable="true"
                android:focusable="true">


                <ImageView
                    android:id="@+id/imgCalendario"
                    android:layout_width="27dp"
                    android:layout_height="27dp"
                    android:contentDescription="Calendario"
                    android:src="@drawable/ic_calendari" />


                <TextView
                    android:id="@+id/txtFecha"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="9dp"
                    android:text="Hoy 27 de agosto de 2026"
                    android:textColor="@color/texto_principal"
                    android:textSize="15sp" />

            </LinearLayout>


            <!-- ================================= -->
            <!-- TÍTULO PREPARACIONES -->
            <!-- ================================= -->

            <TextView
                android:id="@+id/txtTituloPreparaciones"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="40dp"
                android:layout_marginBottom="10dp"
                android:text="Preparaciones de desayuno"
                android:textColor="@color/texto_principal"
                android:textSize="18sp"
                android:textStyle="bold" />


            <!-- ================================= -->
            <!-- CHOCOLATE EN LECHE -->
            <!-- ================================= -->

            <LinearLayout
                android:id="@+id/cardChocolateLeche"
                android:layout_width="match_parent"
                android:layout_height="90dp"
                android:background="@drawable/bg_fecha"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="12dp"
                android:paddingEnd="10dp"
                android:clickable="true"
                android:focusable="true">


                <TextView
                    android:layout_width="58dp"
                    android:layout_height="58dp"
                    android:gravity="center"
                    android:text="🍫"
                    android:textSize="34sp" />


                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="12dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Chocolate en leche"
                        android:textColor="@color/texto_principal"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="07:30 a. m. • 120 porciones"
                        android:textColor="@color/texto_gris"
                        android:textSize="13sp" />

                </LinearLayout>


            </LinearLayout>


            <!-- ================================= -->
            <!-- HUEVO REVUELTO -->
            <!-- ================================= -->

            <LinearLayout
                android:id="@+id/cardHuevoRevuelto"
                android:layout_width="match_parent"
                android:layout_height="90dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_fecha"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="12dp"
                android:paddingEnd="10dp"
                android:clickable="true"
                android:focusable="true">


                <TextView
                    android:layout_width="58dp"
                    android:layout_height="58dp"
                    android:gravity="center"
                    android:text="🍳"
                    android:textSize="34sp" />


                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="12dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Huevo revuelto"
                        android:textColor="@color/texto_principal"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="07:30 a. m. • 120 porciones"
                        android:textColor="@color/texto_gris"
                        android:textSize="13sp" />

                </LinearLayout>


            </LinearLayout>


            <!-- ================================= -->
            <!-- AREPA DE MAÍZ ASADA -->
            <!-- ================================= -->

            <LinearLayout
                android:id="@+id/cardArepaMaiz"
                android:layout_width="match_parent"
                android:layout_height="90dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_fecha"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="12dp"
                android:paddingEnd="10dp"
                android:clickable="true"
                android:focusable="true">


                <TextView
                    android:layout_width="58dp"
                    android:layout_height="58dp"
                    android:gravity="center"
                    android:text="🫓"
                    android:textSize="34sp" />


                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="12dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Arepa de maíz asada"
                        android:textColor="@color/texto_principal"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="07:30 a. m. • 120 porciones"
                        android:textColor="@color/texto_gris"
                        android:textSize="13sp" />

                </LinearLayout>



            </LinearLayout>


            <!-- ================================= -->
            <!-- BANANO -->
            <!-- ================================= -->

            <LinearLayout
                android:id="@+id/cardBanano"
                android:layout_width="match_parent"
                android:layout_height="90dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_fecha"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="12dp"
                android:paddingEnd="10dp"
                android:clickable="true"
                android:focusable="true">


                <TextView
                    android:layout_width="58dp"
                    android:layout_height="58dp"
                    android:gravity="center"
                    android:text="🍌"
                    android:textSize="34sp" />


                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="12dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Banano"
                        android:textColor="@color/texto_principal"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="07:30 a. m. • 120 porciones"
                        android:textColor="@color/texto_gris"
                        android:textSize="13sp" />

                </LinearLayout>


            </LinearLayout>

        </LinearLayout>

    </ScrollView>


    <!-- ================================= -->
    <!-- BARRA INFERIOR -->
    <!-- ================================= -->

    <include
        android:id="@+id/bottomNavigation"
        layout="@layout/bottom_navigation_mani"
        android:layout_width="match_parent"
        android:layout_height="80dp"
        android:layout_gravity="bottom" />

</FrameLayout>
