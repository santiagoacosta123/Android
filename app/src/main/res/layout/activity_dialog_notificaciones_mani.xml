<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_dialog_notificaciones"
    android:padding="14dp">

    <!-- ================================= -->
    <!-- ENCABEZADO -->
    <!-- ================================= -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="42dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Notificaciones"
            android:textColor="@color/azul_original"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnCerrarNotificaciones"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:gravity="center"
            android:text="×"
            android:textColor="@color/texto_gris"
            android:textSize="24sp"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="Cerrar" />

    </LinearLayout>


    <!-- ================================= -->
    <!-- DIVISOR -->
    <!-- ================================= -->

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#EEEEEE" />


    <!-- ================================= -->
    <!-- NOTIFICACIÓN 1 -->
    <!-- ================================= -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:padding="10dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:background="@drawable/bg_notificacion_item">

        <FrameLayout
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:background="@drawable/bg_stat">

            <ImageView
                android:layout_width="25dp"
                android:layout_height="25dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_assignment"
                android:tint="@color/azul_original"
                android:contentDescription="Asignación" />

        </FrameLayout>


        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="10dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Nueva preparación asignada"
                android:textColor="@color/texto_principal"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="Hoy te han asignado Sopa de verduras."
                android:textColor="@color/texto_gris"
                android:textSize="11sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Hace 5 min"
                android:textColor="@color/texto_gris"
                android:textSize="9sp" />

        </LinearLayout>

    </LinearLayout>


    <!-- ================================= -->
    <!-- NOTIFICACIÓN 2 -->
    <!-- ================================= -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="7dp"
        android:padding="10dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:background="@drawable/bg_notificacion_item">

        <FrameLayout
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:background="@drawable/bg_stat">

            <ImageView
                android:layout_width="25dp"
                android:layout_height="25dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_schedule"
                android:tint="@color/amarillo_dorado"
                android:contentDescription="Aviso" />

        </FrameLayout>


        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="10dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Preparación próxima"
                android:textColor="@color/texto_principal"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="Arroz con pollo comienza a las 12:30 p. m."
                android:textColor="@color/texto_gris"
                android:textSize="11sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Hace 15 min"
                android:textColor="@color/texto_gris"
                android:textSize="9sp" />

        </LinearLayout>

    </LinearLayout>


    <!-- ================================= -->
    <!-- NOTIFICACIÓN 3 -->
    <!-- ================================= -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="7dp"
        android:padding="10dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:background="@drawable/bg_notificacion_item">

        <FrameLayout
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:background="@drawable/bg_stat">

            <ImageView
                android:layout_width="25dp"
                android:layout_height="25dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_inventory"
                android:tint="@color/rojo_alerta"
                android:contentDescription="Inventario" />

        </FrameLayout>


        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="10dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Inventario por revisar"
                android:textColor="@color/texto_principal"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="Se está terminando un producto del inventario."
                android:textColor="@color/texto_gris"
                android:textSize="11sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Hace 30 min"
                android:textColor="@color/texto_gris"
                android:textSize="9sp" />

        </LinearLayout>

    </LinearLayout>


    <!-- ================================= -->
    <!-- VER TODAS -->
    <!-- ================================= -->

    <TextView
        android:id="@+id/btnVerTodasNotificaciones"
        android:layout_width="match_parent"
        android:layout_height="38dp"
        android:layout_marginTop="10dp"
        android:gravity="center"
        android:text="Ver todas las notificaciones"
        android:textColor="@color/azul_original"
        android:textSize="11sp"
        android:textStyle="bold"
        android:clickable="true"
        android:focusable="true" />

</LinearLayout>